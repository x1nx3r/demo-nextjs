# RustFS (S3-compatible, self-hosted) — storage for EPUBs, audio and JSON state
RUSTFS_ENDPOINT=https://cdn.x1nx3r.dev
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=audiobook
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# --- Article sources ---
# Medium blocks direct fetches. A Freedium instance renders Medium articles by
# wrapping the URL. Leave it empty to fetch Medium directly.
FREEDIUM_URL=https://freedium.x1nx3r.dev

# --- Firebase (auth + Firestore user bookkeeping) ---
# Web config: public by design (safe in the client bundle).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Service account JSON, base64-encoded. Server only; never expose to the client.
# Firebase console -> Project settings -> Service accounts -> Generate new private key,
# then: base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCJSON_BASE64=

# --- Speech (TTS) ---
# Provider: fish (default) | elevenlabs
TTS_PROVIDER=fish

# Fish Audio, direct API. Key: https://fish.audio  ->  Dashboard -> API keys.
# The free developer model is s2.1-pro-free (same model as paid, $0, fair use).
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free

# Optional explicit voice pool as `id:Name,id:Name,...`. The first id is the
# narrator. Each id is a Fish reference_id (a library voice or one you cloned).
FISH_VOICE_IDS=

# Max Fish renders at once (default 3). Raise it only if the account allows it.
FISH_CONCURRENCY=3

# ElevenLabs, direct — kept as the alternate provider.
ELEVENLABS_API_KEY=

# Optional: explicit cast voice pool as `id:Name,id:Name,...`. The first id is
# the narrator. If unset, a small built-in fallback pool is used. List available
# voices at GET /api/voices.
CAST_VOICE_IDS=
# Optional: ceiling on cast size (default 24). Not a model limit.
MAX_CAST_CHARACTERS=24

# --- LLM (planning + casting) ---
# Provider: opencode-go (default) | openrouter
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_DIRECTOR_MODEL=deepseek-v4.1-flash
LLM_PLANNER_MODEL=deepseek-v4.1-flash

# OpenCode Go key. LLM_API_KEY falls back to this.
OPENCODE_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
INGEST_MODEL=deepseek-v4.1-flash
