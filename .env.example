# RustFS (S3-compatible, self-hosted) — storage for EPUBs, audio and JSON state
RUSTFS_ENDPOINT=https://cdn.x1nx3r.dev
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=audiobook
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Session signing secret (long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Text-to-speech (ElevenLabs) and context-tagging LLM (OpenCode Go) — added later
ELEVENLABS_API_KEY=
OPENCODE_API_KEY=
